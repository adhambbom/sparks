# ============================================================
# Synthetic Sparks — Repository Ignore Rules
# ------------------------------------------------------------
# Keeps secrets, heavy caches, build artifacts, and machine-
# specific files out of version control. Anything that should
# exist as documentation (e.g. .env templates) is checked in
# under a *.example suffix instead.
# ============================================================

# ── Dependencies ─────────────────────────────────────────────
node_modules/
.expo/
dist/
build/
.metro-cache/
.turbo/
.cache/
__pycache__/
*.pyc
*.pyo
*.egg-info/
.venv/
venv/
.pytest_cache/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ── Environment & Secrets ────────────────────────────────────
# Real environment files — never commit. Use the *.example
# templates checked in alongside as starting points.
.env
.env.production
.env.staging
.env.local
.env.*.local

# Android signing artifacts
*.jks
*.keystore
*.p12
google-services.json
play-store-service-account.json

# iOS signing artifacts
*.mobileprovision
*.p8
GoogleService-Info.plist

# ── Build Outputs ────────────────────────────────────────────
# Native projects — regenerated by `expo prebuild`
android/
ios/
frontend/android/
frontend/ios/

# Compiled mobile bundles
*.apk
*.aab
*.ipa
*.dSYM.zip

# Web build outputs
web-build/
out/

# ── Sensitive test artifacts ─────────────────────────────────
/app/memory/test_credentials.md
memory/test_credentials.md
/memory/test_credentials.md

# ── IDE / OS noise ───────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# ── Logs ─────────────────────────────────────────────────────
logs/
*.log
-e 
# Environment and credential files
.env
.env.*
*.env
credentials.json
*.pem
*.key
.credentials
-e 
# Environment and credential files
.env
.env.*
*.env
credentials.json
*.pem
*.key
.credentials
-e 
# Environment and credential files
.env
.env.*
*.env
credentials.json
*.pem
*.key
.credentials
